# Copy to .env and fill in. Everything here can also be entered in the dashboard (Settings → Integrations);
# values saved in the dashboard take precedence.

PORT=4317
# Sign-in (accounts + optional 2FA) is on by default. Only set AUTH_ENABLED=0 for a private, local-only setup.
AUTH_ENABLED=
# Email that owns the existing data (default: the sender email saved in it). Claiming it needs a code sent there.
OWNER_EMAIL=
# Set to "closed" to stop new sign-ups (each new account otherwise gets its own empty workspace).
SIGNUPS=
# Public https address once deployed (e.g. https://app.yourdomain.com) — enables unsubscribe links and the Clay webhook.
PUBLIC_BASE_URL=

# HubSpot private app token. Scopes: crm.objects.companies.read, crm.objects.companies.write,
# crm.objects.contacts.read, crm.schemas.companies.read
HUBSPOT_TOKEN=

# Hostinger mailbox (the outreach sender)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Apollo (optional). API search stays OFF until enabled in Integrations; CSV export import is recommended.
APOLLO_API_KEY=
# Hunter.io (optional) — finds published emails for companies whose own site shows none.
HUNTER_API_KEY=
# Clay webhook shared secret (or generate one on Discover & import → Clay webhook)
CLAY_WEBHOOK_SECRET=

# Groq (free AI email writing) — get a key at console.groq.com/keys. Put the real key in .env, not here.
GROQ_API_KEY=
