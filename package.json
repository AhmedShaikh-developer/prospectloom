{
  "name": "localhost-labs-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Localhost Labs B2B client acquisition pipeline: research, verification, CRM sync, outreach and reply handling.",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --disable-warning=ExperimentalWarning --test 'tests/unit/*.test.js'",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^4.22.3",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
